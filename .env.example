# Copy to .env and replace password with a strong random local-only value.
POSTGRES_DB=bbnator
POSTGRES_USER=bbnator
POSTGRES_PASSWORD=replace-with-a-strong-random-password
# Separate password for the application's database role bbnator_app (row-level security applies to it).
APP_DB_PASSWORD=replace-with-a-different-random-password
DB_PORT=5433
HTTP_PORT=8088

# Profile: 'demo' = fictional data, no login, local only. Remove 'demo' for real sign-in.
SPRING_PROFILES_ACTIVE=demo
BBNATOR_DEMO_ACKNOWLEDGED=true

# Sign-in (ignored in demo profile). Use ldaps:// in production.
# Set to true as soon as the application is served over HTTPS.
SESSION_COOKIE_SECURE=false
BBNATOR_TENANT_ID=local
BBNATOR_BOOTSTRAP_ADMIN=
LDAP_URL=
LDAP_BASE=
LDAP_USER_SEARCH_BASE=ou=people
LDAP_USER_SEARCH_FILTER=(uid={0})
LDAP_SUBJECT_ATTRIBUTE=uid
LDAP_MANAGER_DN=
LDAP_MANAGER_PASSWORD=
